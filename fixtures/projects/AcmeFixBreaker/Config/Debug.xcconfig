// Project-level base xcconfig of Debug (xcblame fix --install-hook appends its #include? here).
// Planted breaker (SET-030): the Read Inputs script reads an undeclared file, so turning user
// script sandboxing on (ENABLE_USER_SCRIPT_SANDBOXING = YES) breaks the build.
#include "Shared.xcconfig"

SWIFT_OPTIMIZATION_LEVEL = -Onone
SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG
GCC_OPTIMIZATION_LEVEL = 0
ONLY_ACTIVE_ARCH = YES
ENABLE_TESTABILITY = YES
COPY_PHASE_STRIP = NO
DEBUG_INFORMATION_FORMAT = dwarf
VALIDATE_PRODUCT = NO
